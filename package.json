    "ky": "^2.1.0",
    "matrix-js-sdk": "^42.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "redux": "^5.0.1",
    "redux-logger": "^3.0.6",
    "redux-thunk": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@vitejs/plugin-react": "^6.1.1",
