flowchart TD
  Start["main.jsx: configureStore() + Provider / HashRouter / ThemeProvider"] --> App["App.jsx: MenuAppContainer + MtrxContainer"]

  App -->|"меню: displayAd"| AdShow

  App --> Boot["MtrxContainer: useEffect -> handleRestoreSession()"]

  Boot --> Guard{"Пропустить восстановление? status == 'success' или уже идёт"}
  Guard -->|"да"| Skip["Ничего не делаем"]
  Guard -->|"нет"| Active{"getActiveMatrixSession() - клиент уже запущен?"}

  Active -->|"да"| Watch["watchMatrixSession(client) - подписка на Session.logged_out"]
  Active -->|"нет"| Restore["restoreMatrixSession() - чтение токенов из localStorage"]

  Restore --> Tokens{"Токены корректны?"}
  Tokens -->|"нет"| Clear["dispatch MTRXCTL_CLEAR"]
  Tokens -->|"да"| Create["createMatrixClientFromSession() - createClient + initRustCrypto"]

  Create --> Whoami["client.whoami() - проверка access token"]
  Whoami -->|"401"| Dead["destroyMatrixClient() + deleteMatrixLocalStores()"]
  Dead --> Clear
  Whoami -->|"ок"| Sync["startMatrixSync() - startClient({initialSyncLimit:10})"]

  Watch --> Sync
  Sync --> Success["dispatch MTRXCTL_SUBMIT_SUCCESS"]

  Success --> Pad["MtrxPad: список комнат"]
  Clear --> Reg["MtrxReg: вход в Matrix"]

  Reg --> Submit["Submit -> handleRegister()"]
  Submit --> Check{"login и password заполнены?"}
  Check -->|"нет"| ErrReg["dispatch MTRXCTL_SUBMIT_ERROR"]
  Check -->|"да"| Loading["dispatch MTRXCTL_SUBMIT_REQUEST"]

  Loading --> LoginSvc["loginMatrix(): tempClient.loginRequest()"]
  LoginSvc --> Recreate["createMatrixClientFromSession() + persistMatrixSession()"]
  Recreate --> SyncLogin["startMatrixSync()"]
  SyncLogin --> SuccessLogin["dispatch MTRXCTL_SUBMIT_SUCCESS"]
  SuccessLogin --> Pad
  LoginSvc -.->|"ошибка"| ErrReg

  Pad --> Rooms["getJoinedRooms() + watchRoomChanges()"]
  Rooms --> RoomList["MtrxRoomList: выбор комнаты"]

  Pad --> Logout["Кнопка «Выйти» -> handleRegClear()"]
  Logout --> LogoutSvc["logoutMatrix(): stopClient + logout + clearStores"]
  LogoutSvc --> Clear

  LoggedOut["Событие Matrix: Session.logged_out"] --> Invalidate["invalidateMatrixSession()"]
  Invalidate --> Clear

  subgraph AD["AD-авторизация (AuthAd)"]
    AdShow["AuthAd отображается (displayAd)"] --> AdSubmit["Submit -> handleAdRegister()"]
    AdSubmit --> AdCheck{"login, password, uriAdAuth заданы?"}
    AdCheck -->|"нет"| AdErr["dispatch AUTHCTL_SUBMIT_ERROR"]
    AdCheck -->|"да"| AdReq["dispatch AUTHCTL_SUBMIT_REQUEST"]
    AdReq --> Ky["ky.post(uriAdAuth, {login, password})"]
    Ky --> AdSucc["dispatch AUTHCTL_SUBMIT_SUCCESS + localStorage adLogin/adAuthExpireTime"]
    AdSucc --> AdHide["AuthAd скрывается"]
    Ky -.->|"ошибка"| AdErr
  end

  Timer["authTimeoutMiddleware: setInterval(10s) проверка adAuthExpireTime"] -->|"истёк"| AdClear["dispatch AUTHCTL_CLEAR"]
