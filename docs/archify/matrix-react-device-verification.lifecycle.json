  "cards": [
    {
      "dot": "emerald",
      "title": "Основной путь SAS",
      "items": [
        "handleRequestDeviceVerification ставит status loading, requestCurrentDeviceVerification даёт фазу requested",
        "acceptCurrentDeviceVerification → ready, startCurrentDeviceVerification запускает m.sas.v1 и emoji",
        "confirmCurrentDeviceVerification подтверждает SAS; verified приходит crypto-событиями с задержкой"
      ]
    },
    {
      "dot": "cyan",
      "title": "Recovery key и Secret Storage",
      "items": [
        "verifyCurrentDeviceWithRecoveryKey декодирует ключ, ждёт /sync и сверяет его через checkKey",
        "createNewSecretStorage создаётся по подтверждению и показывает новый recoveryKey",
        "resetOwnEncryption по паролю делает новую кросс-подпись, Secret Storage и ключ"
      ]
    },
    {
      "dot": "rose",
      "title": "Ошибки VERIFICATION_ERR",
      "items": [
        "INVALID_KEY, KEY_MISMATCH, SYNC_INCOMPLETE, STORAGE_EXISTS → форма и «Ввести другой ключ» или «Повторить»",
        "NO_SECRET_STORAGE → создать хранилище секретов",
        "CROSS_SIGNING_MISSING и RESET_FAILED → авторизация с другого устройства или сброс E2EE"
      ]
    }
  ]
