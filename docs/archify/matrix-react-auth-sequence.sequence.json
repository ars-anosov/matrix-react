    },
    {
      "id": "rest",
      "type": "backend",
      "label": "restAuth",
      "sublabel": "REST-авторизация · ky"
    },
    {
      "id": "matrix",
      "type": "backend",
      "label": "matrixClient",
      "sublabel": "Matrix-сессия"
    },
    {
      "id": "restSrv",
      "type": "external",
      "label": "REST-сервис",
      "sublabel": "POST uriRestAuth"
    },
    {
      "id": "hs",
      "type": "external",
      "label": "Homeserver",
      "sublabel": "/login · /sync"
    }
  ],
  "segments": [
    {
      "from": 155,
      "to": 480,
      "label": "REST-вход"
    },
    {
      "from": 490,
      "to": 790,
      "label": "Вход Matrix"
    },
    {
      "from": 800,
      "to": 975,
      "label": "Сброс"
    }
  ],
  "messages": [
    {
      "id": "rest-form",
      "from": "person",
      "to": "auth",
      "y": 185,
      "label": "ввод REST-учётных данных"
    },
    {
      "id": "rest-login",
      "from": "auth",
      "to": "rest",
      "y": 225,
      "label": "loginRest",
      "variant": "emphasis"
    },
    {
      "id": "rest-service",
      "from": "rest",
      "to": "restSrv",
      "y": 265,
      "label": "POST uriRestAuth (login · password)"
    },
    {
      "id": "rest-service-ok",
      "from": "restSrv",
      "to": "rest",
      "y": 305,
      "label": "ad_login · mtrx_login · mtrx_password",
      "variant": "return"
    },
    {
      "id": "rest-store",
      "from": "rest",
      "to": "storage",
      "y": 345,
      "label": "uriRestAuth · restLogin · restAuthExpireTime"
    },
    {
      "id": "rest-result",
      "from": "rest",
      "to": "redux",
      "y": 385,
      "label": "AUTHCTL_SUBMIT_SUCCESS · mtrx_login · mtrx_password"
    },
    {
      "id": "rest-read",
      "from": "redux",
      "to": "bridge",
      "y": 425,
      "label": "useSelector: responseData",
      "variant": "return"
    },
    {
      "id": "show-bridge",
      "from": "bridge",
      "to": "auth",
      "y": 465,
      "label": "AuthPad · логин в форму",
      "variant": "return"
    },
    {
      "id": "toggle-on",
      "from": "person",
      "to": "auth",
      "y": 505,
      "label": "включить тумблер"
    },
    {
      "id": "invoke-bridge",
      "from": "auth",
      "to": "bridge",
      "y": 545,
      "label": "onToggleMtrx"
    },
    {
      "id": "matrix-login",
      "from": "bridge",
      "to": "matrix",
      "y": 585,
      "label": "handleRegister → loginMatrix",
      "variant": "emphasis"
    },
    {
      "id": "matrix-post",
      "from": "matrix",
      "to": "hs",
      "y": 625,
      "label": "POST /_matrix/client/v3/login"
    },
    {
      "id": "matrix-post-ok",
      "from": "hs",
      "to": "matrix",
      "y": 665,
      "label": "access_token · device_id",
      "variant": "return"
    },
    {
      "id": "matrix-store",
      "from": "matrix",
      "to": "storage",
      "y": 705,
      "label": "uriMatrix · токены · mtrxDeviceId"
    },
    {
      "id": "matrix-status",
      "from": "matrix",
      "to": "redux",
      "y": 745,
      "label": "MTRXCTL_SUBMIT_SUCCESS / ERROR"
    },
    {
      "id": "toggle-color",
      "from": "redux",
      "to": "auth",
      "y": 785,
      "label": "useSelector: статус → цвет тумблера",
      "variant": "return"
    },
    {
      "id": "toggle-off",
      "from": "person",
      "to": "auth",
      "y": 825,
      "label": "клик по цветному тумблеру"
    },
    {
      "id": "session-clear",
      "from": "bridge",
      "to": "matrix",
      "y": 865,
      "label": "handleRegClear → logoutMatrix",
      "variant": "emphasis"
    },
    {
      "id": "session-purge",
      "from": "matrix",
      "to": "storage",
      "y": 905,
      "label": "удаление токенов сессии"
    },
    {
      "id": "store-clear",
      "from": "bridge",
      "to": "redux",
      "y": 945,
      "label": "MTRXCTL_CLEAR"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Граница срезов",
      "items": [
        "Только AuthContainer связывает AUTHCTL_ и MTRXCTL_",
        "Оба среза сходятся в Redux: authControlRdcr и mtrxControlRdcr",
        "Пароль REST не кладётся в Matrix Redux"
      ]
    },
    {
      "dot": "emerald",
      "title": "Тумблер",
      "items": [
        "Отключён — вход данными REST",
        "Успех или ошибка — сброс сессии"
      ]
    },
    {
      "dot": "violet",
      "title": "Хранилище",
      "items": [
        "Ключи REST и Matrix пишутся в localStorage",
        "При сбросе токены удаляются, адрес и логин остаются",
        "Вместе с ними чистятся IndexedDB-хранилища sync и crypto"
      ]
    }
  ]
}
