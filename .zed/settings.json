{
  "file_scan_exclusions": ["**/node_modules", "**/dist", "**/.git"],
  "global_lsp_settings": {
    "request_timeout": 15
  },
  "languages": {
    "JavaScript": {
      "language_servers": ["vtsls", "biome"],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JSON": {
      "language_servers": ["biome"],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      }
    },
    "JSONC": {
      "language_servers": ["biome"],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      }
    }
  }
}
