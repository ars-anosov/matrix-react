# Dependency directories
node_modules/
dist/

# Playwright CLI: рантайм-состояние демона, профиль браузера и вывод проверок.
# Конфиг .playwright/cli.config.json, наоборот, коммитится — это часть настройки.
.playwright/cache/

# archify: в репозитории остаются только превью-PNG для README и receipt визуальной проверки.
# Остальные скриншоты и contact sheet — временные, их не коммитим.
docs/archify/*.visual-check.*.png
!docs/archify/*.visual-check.2048x1320.light.png
docs/archify/*.visual-check.html
